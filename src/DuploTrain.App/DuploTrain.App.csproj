<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>duplo-train</AssemblyName>
    <RootNamespace>DuploTrain.App</RootNamespace>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>

    <!-- Published thin and run with `dotnet duplo-train.dll`, so no runtime
         identifier and no self-contained bundle. Needs the .NET Desktop Runtime
         8 on the target: the Windows TFM makes the runtimeconfig require both
         Microsoft.NETCore.App and Microsoft.WindowsDesktop.App. -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DuploTrain.Windows/DuploTrain.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
