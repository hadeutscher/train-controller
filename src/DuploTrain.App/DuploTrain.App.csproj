<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe, not Exe: the window exists so that Windows' gamepad navigation
         has a focused window to act on. With only a console, a stray stick nudge
         walked the focus onto the console's close button. -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>

    <AssemblyName>duplo-train</AssemblyName>
    <RootNamespace>DuploTrain.App</RootNamespace>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>

    <!-- Published thin and run with `dotnet duplo-train.dll`, so no runtime
         identifier and no self-contained bundle. Needs the .NET Desktop Runtime
         8 on the target. -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DuploTrain.Windows/DuploTrain.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
